# ==============================================================================
# Lean4 Prover — environment variables (Rust service)
# ==============================================================================
# Every variable the service reads, with its default. Copy this file to .env for
# local runs. The examples here run standalone: no licence server needed.

# ------------------------------------------------------------------------------
# Core
# ------------------------------------------------------------------------------
LEAN4_PROVER_VERSION=0.1.0
LEAN4_PROVER_SERVICE_NAME=lean4-prover
ENVIRONMENT=development
ENABLE_DOCS=true
# The licence gate. Defaults to TRUE when unset; setting it to false serves every
# request with no licence check. Boot REFUSES to start when this is true and
# LICENSE_INTROSPECT_URL is empty.
ENABLE_AUTH=false
# The licence service: one `POST {"token": ...}`; a 200 with `active` decides.
LICENSE_INTROSPECT_URL=https://licences.example.com/license/introspect
# Wall-clock budget for that POST, in seconds (1..120).
LICENSE_INTROSPECT_TIMEOUT=10

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------
LEAN4_PROVER_BIND_HOST=0.0.0.0
LEAN4_PROVER_BIND_PORT=8812

# ------------------------------------------------------------------------------
# Lean 4 — defaults are the Docker layout (/opt/elan, /lean-project).
# A host run must point these at its own elan install and lake project.
# ------------------------------------------------------------------------------
LEAN4_PROVER_LEAN_BINARY=/opt/elan/bin/lean
LEAN4_PROVER_LAKE_BINARY=/opt/elan/bin/lake
LEAN4_PROVER_PROJECT_DIR=/lean-project
LEAN4_PROVER_ELAN_HOME=/opt/elan
LEAN4_PROVER_SUBPROCESS_PATH=/usr/local/bin:/usr/bin:/bin:/opt/elan/bin
LEAN4_PROVER_TIMEOUT=120
LEAN4_PROVER_MAX_MEMORY_MB=4096

# ------------------------------------------------------------------------------
# Admission — one `prove` lane shared by check/elaborate/prove.
# Saturation answers 503 + Retry-After (never 429).
# ------------------------------------------------------------------------------
GPU_LANE_PROVE_MAX_ACTIVE=2
GPU_LANE_PROVE_MAX_WAITING=8
GPU_LANE_PROVE_MAX_WAIT_S=30

# ------------------------------------------------------------------------------
# CORS
# ------------------------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:8921,http://localhost:3000,http://127.0.0.1:3000
